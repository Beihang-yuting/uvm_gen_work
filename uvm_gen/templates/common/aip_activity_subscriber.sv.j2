`ifndef  AIP_ACTIVITY_SUBSCRIBER__SV
`define  AIP_ACTIVITY_SUBSCRIBER__SV

// EXPLICIT OPT-IN activity subscriber — connect only when monitor-wide activity
// is the intended progress signal. Unrelated transactions can mask a stuck AIP command.
// Prefer aip_activity::tick() at the active command's real progress boundary.
// Explicit usage:
//   aip_activity_subscriber #(my_trans) activity_sub;
//   activity_sub = new("activity_sub", this);
//   agent.m_mon.m_ap.connect(activity_sub.analysis_export);

class aip_activity_subscriber #(type T = uvm_sequence_item) extends uvm_subscriber #(T);

    `uvm_component_param_utils(aip_activity_subscriber #(T))

    function new(string name, uvm_component parent);
        super.new(name, parent);
    endfunction

    function void write(T t);
        aip_activity::tick();
    endfunction

endclass

`endif

{{ header(file_name) }}
`ifndef  {{ block_name | upper }}_RM__SV
`define  {{ block_name | upper }}_RM__SV

class {{ block_name }}_rm extends uvm_component;

    `uvm_component_utils_begin({{ block_name }}_rm)
    `uvm_component_utils_end

    // dec common rm member

    // dec in_port — standard: get data from FIFO via uvm_blocking_get_port
{% for agent in agents %}
    uvm_blocking_get_port#({{ agent.name }}_trans)   m_from_{{ agent.name }}_agt_mon_port;
{% endfor %}

    // dec out_port — send processed transactions to checker via analysis_port
{% for agent in agents %}
    uvm_analysis_port#({{ agent.name }}_trans)       m_rm_{{ agent.name }}_trans_to_scb_port;
{% endfor %}

    int              m_active_worker_count;
    bit              m_workers_running;
    bit              m_run_phase_started;
    longint unsigned m_worker_epoch;
    longint unsigned m_worker_restart_request_epoch;
    longint unsigned m_worker_start_ack_epoch;

    extern function new(string name, uvm_component parent);
    extern virtual function void build_phase(uvm_phase phase);
    extern virtual task run_phase(uvm_phase phase);
    extern virtual task supervise_workers();
    extern virtual task start_workers();
    extern virtual task stop_workers();
    extern virtual task wait_for_workers_stopped();
    extern virtual task request_workers_restart();
    extern virtual task wait_for_workers_started();
{% for agent in agents %}
    extern virtual task process_trans_from_{{ agent.name }}_agt();
{% endfor %}

endclass

function {{ block_name }}_rm::new(string name, uvm_component parent);
    super.new(name, parent);
    m_workers_running = 0;
    m_run_phase_started = 0;
    m_worker_epoch = 0;
    m_worker_restart_request_epoch = 0;
    m_worker_start_ack_epoch = 0;
    m_active_worker_count = 0;
endfunction

function void {{ block_name }}_rm::build_phase(uvm_phase phase);
    super.build_phase(phase);
{% for agent in agents %}
    m_from_{{ agent.name }}_agt_mon_port     = new("m_from_{{ agent.name }}_agt_mon_port", this);
    m_rm_{{ agent.name }}_trans_to_scb_port  = new("m_rm_{{ agent.name }}_trans_to_scb_port", this);
{% endfor %}
endfunction

task {{ block_name }}_rm::run_phase(uvm_phase phase);
    super.run_phase(phase);
    m_run_phase_started = 1;
    this.supervise_workers();
endtask

task {{ block_name }}_rm::supervise_workers();
    longint unsigned handled_restart_epoch;

    handled_restart_epoch = m_worker_restart_request_epoch;
    this.start_workers();
    m_worker_start_ack_epoch = handled_restart_epoch;
    forever begin
        wait (m_worker_restart_request_epoch != handled_restart_epoch);
        handled_restart_epoch = m_worker_restart_request_epoch;
        this.start_workers();
        m_worker_start_ack_epoch = handled_restart_epoch;
    end
endtask

task {{ block_name }}_rm::start_workers();
    longint unsigned launch_epoch;

    if (m_workers_running) return;
    m_workers_running = 1;
    m_worker_epoch++;
    launch_epoch = m_worker_epoch;
    m_active_worker_count = 0;
    fork
{% for agent in agents %}
        begin
            if (launch_epoch == m_worker_epoch && m_workers_running) begin
                m_active_worker_count++;
                this.process_trans_from_{{ agent.name }}_agt();
                m_active_worker_count--;
            end
        end
{% endfor %}
    join_none
{% if agents %}
    wait (launch_epoch != m_worker_epoch || m_active_worker_count == {{ agents | length }});
{% endif %}
endtask

task {{ block_name }}_rm::stop_workers();
    m_workers_running = 0;
    m_worker_epoch++;
endtask

task {{ block_name }}_rm::wait_for_workers_stopped();
    wait (m_active_worker_count == 0);
endtask

task {{ block_name }}_rm::request_workers_restart();
    m_worker_restart_request_epoch++;
endtask

task {{ block_name }}_rm::wait_for_workers_started();
    longint unsigned requested_restart_epoch;

    requested_restart_epoch = m_worker_restart_request_epoch;
    wait (m_run_phase_started
          && m_worker_start_ack_epoch >= requested_restart_epoch);
endtask

{% for agent in agents %}
task {{ block_name }}_rm::process_trans_from_{{ agent.name }}_agt();
    {{ agent.name }}_trans    tr;
    uvm_object                cloned;
    {{ agent.name }}_trans    prediction;
    longint unsigned          worker_epoch;
    `uvm_info(get_full_name(), "process_trans_from_{{ agent.name }}_agt start", UVM_NONE);
    while(1) begin
        worker_epoch = m_worker_epoch;
        this.m_from_{{ agent.name }}_agt_mon_port.get(tr);
        if (!m_workers_running || worker_epoch != m_worker_epoch) break;
        if (tr == null) begin
            m_rm_{{ agent.name }}_trans_to_scb_port.write(null);
        end
        else begin
            cloned = tr.clone();
            if (cloned == null || !$cast(prediction, cloned)) begin
                `uvm_error(get_full_name(), "failed to clone {{ agent.name }} prediction")
            end
            else begin
                // Update prediction with reference-model behavior; never modify tr.
                m_rm_{{ agent.name }}_trans_to_scb_port.write(prediction);
            end
        end
    end
endtask

{% endfor %}

`endif

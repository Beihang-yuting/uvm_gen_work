{{ header(file_name) }}
`ifndef  {{ block_name | upper }}_CHECKER__SV
`define  {{ block_name | upper }}_CHECKER__SV

class {{ block_name }}_checker extends uvm_scoreboard;

    `uvm_component_utils_begin({{ block_name }}_checker)
    `uvm_component_utils_end

    int     m_scb_rec_rm_trans_total_cnt;
    int     m_scb_rec_dut_trans_total_cnt;

{% for agent in agents %}
    common_uvm_scb#({{ agent.name }}_trans) m_{{ agent.name }}_scb;
{% endfor %}

    extern function new(string name, uvm_component parent=null);
    extern virtual function void build_phase(uvm_phase phase);
    extern virtual task run_phase(uvm_phase phase);
    extern virtual function void reset_state();
    extern virtual task reset_phase(uvm_phase phase);
{% for agent in agents %}
    extern virtual task send_{{ agent.name }}_actual(input {{ agent.name }}_trans tr);
    extern virtual task send_{{ agent.name }}_expected(input {{ agent.name }}_trans tr);
{% endfor %}

endclass

function {{ block_name }}_checker::new(string name, uvm_component parent=null);
    super.new(name, parent);
    m_scb_rec_rm_trans_total_cnt  = 0;
    m_scb_rec_dut_trans_total_cnt = 0;
endfunction

function void {{ block_name }}_checker::build_phase(uvm_phase phase);
    super.build_phase(phase);
{% for agent in agents %}
    m_{{ agent.name }}_scb = common_uvm_scb#({{ agent.name }}_trans)::type_id::create(
        "m_{{ agent.name }}_scb", this);
{% endfor %}
endfunction

task {{ block_name }}_checker::run_phase(uvm_phase phase);
    super.run_phase(phase);
    `uvm_info(get_full_name(), "checker run_phase start", UVM_NONE);
endtask

{% for agent in agents %}
task {{ block_name }}_checker::send_{{ agent.name }}_actual(input {{ agent.name }}_trans tr);
    m_scb_rec_dut_trans_total_cnt++;
    if (tr == null) begin
        m_{{ agent.name }}_scb.push_actual(tr, '1, -1);
    end
    else begin
        m_{{ agent.name }}_scb.push_actual(
            tr, tr.get_scb_stream_id(), tr.get_scb_kind());
    end
endtask : send_{{ agent.name }}_actual

task {{ block_name }}_checker::send_{{ agent.name }}_expected(input {{ agent.name }}_trans tr);
    m_scb_rec_rm_trans_total_cnt++;
    if (tr == null) begin
        m_{{ agent.name }}_scb.push_expected(tr, '1, -1);
    end
    else begin
        m_{{ agent.name }}_scb.push_expected(
            tr, tr.get_scb_stream_id(), tr.get_scb_kind());
    end
endtask : send_{{ agent.name }}_expected

{% endfor %}
function void {{ block_name }}_checker::reset_state();
{% for agent in agents %}
    m_{{ agent.name }}_scb.reset_state();
{% endfor %}
endfunction

task {{ block_name }}_checker::reset_phase(uvm_phase phase);
    super.reset_phase(phase);
    reset_state();
endtask

`endif
